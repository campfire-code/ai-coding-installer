          "name": "u.ver.hermes",
          "cmd": "sh",
          "args": [
            "-c",
            "export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; hermes --version"
          ]
        },
        {
          "name": "u.arch",
          "cmd": "sh",
          "args": [
            "-c",
            "export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; uname -m"
          ]
        },
        {
          "name": "u.install.claude.native",
          "cmd": "sh",
          "args": [
            "-c",
            "export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; curl -fsSL https://claude.ai/install.sh | bash"
          ]
        },
        {
          "name": "u.install.claude.brew",
          "cmd": "sh",
          "args": [
            "-c",
            "export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; brew install --cask claude-code"
          ]

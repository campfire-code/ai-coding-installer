            "-c",
            "export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; command -v npm >/dev/null && npm --version"
          ]
        },
        {
          "name": "u.has.brew",
          "cmd": "sh",
          "args": [
            "-c",
            "export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; command -v brew >/dev/null && brew --version"
          ]
        },
        {
          "name": "u.has.claude",

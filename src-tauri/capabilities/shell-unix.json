          "name": "u.install.claude.npm",
          "cmd": "sh",
          "args": [
            "-c",
            "export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; npm install -g @anthropic-ai/claude-code"
          ]
        },
        {
          "name": "u.install.codex.native",
          "cmd": "sh",
          "args": [
            "-c",
            "export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; curl -fsSL https://chatgpt.com/codex/install.sh | sh"

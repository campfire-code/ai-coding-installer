          ]
        },
        {
          "name": "u.ver.codex",
          "cmd": "sh",
          "args": [
            "-c",
            "export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; codex --version"
          ]
        },

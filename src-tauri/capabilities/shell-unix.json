{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell-unix",
  "description": "只允许执行白名单里的安装与检测命令（macOS / Linux），每条命令的参数写死",
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS",
    "linux"
  ],
  "permissions": [
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "u.has.node",
          "cmd": "sh",
          "args": [
            "-c",
            "export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; command -v node >/dev/null && node --version"
          ]
        },
        {
          "name": "u.has.git",
          "cmd": "sh",
          "args": [
            "-c",
            "export PATH=\"$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH\"; command -v git >/dev/null && git --version"
          ]
        },
        {
          "name": "u.has.npm",
